ID = ztx.hinges_pistons_docking
Name = "Hinges, Pistons and Docking"
Version = 1.0.0
CompatibleGameVersions = ["0.30.5"]
ModifiesGameplay = true
ModifiesMultiplayer = true
Author = "ZTX"
Logo = "logo.png"
StringsFolder = "strings"

ShipLibraries
[
	{
		Folder = "ships"
		NameKey = "ShipLibraries/HingesDocking"
		TooltipKey = "ShipLibraries/HingesDockingTip"
	}
]
Description = "Hinges, motors, pistons, rails and carts, docking, build bays and programmable logic for Cosmoteer, built on the game's own physics joints. Jointed sections stay one ship: they take orders together, share crew and supplies, fly as one and jump as one. Needs the YAML mod loader (Steam Workshop 3577650065). Single player only in 1.0.0. See README.md beside the DLL for the parts and how to install."

